{
  "name": "project-planner-website",
  "version": "0.1.0",
  "private": true,
  "description": "Public website for Project Planner — a preview of the upcoming AI-powered project planning workspace for Windows.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "npx serve out",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "check:gradients": "node scripts/check-no-gradients.mjs",
    "test:e2e": "playwright test",
    "verify": "npm run typecheck && npm run lint && npm run check:gradients && npm run build"
  },
  "dependencies": {
    "lucide-react": "^1.47.0",
    "next": "^16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "^16.3.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  }
}
